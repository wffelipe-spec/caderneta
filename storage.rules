rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /familias/{fid}/{arquivo} {
      function membro() {
        return request.auth != null
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.familiaId == fid;
      }
      allow read: if membro();
      allow create: if membro() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if membro();
    }
  }
}
